# Шаблон конфигурации. Скопируйте его в .env и подставьте реальные значения:
#
#   cp .env.example .env
#
# Приложение проверяет конфигурацию при старте и не запустится, пока
# значения остались заглушками CHANGE_ME.

# ─────────────────────────────────────────────────────────────────────────────
# HTTP-сервер
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# База данных
# ─────────────────────────────────────────────────────────────────────────────
# Формат: postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА?sslmode=disable
DATABASE_URL=CHANGE_ME
MIGRATIONS_DIR=db/migrations

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
# Обязательно замените оба секрета. Сгенерировать:
#   openssl rand -base64 48
# Значения должны различаться: иначе refresh-токен можно будет проверить
# секретом access-токена.
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# Access-токен короткоживущий, refresh — долгоживущий.
ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_TTL=720h
JWT_ISSUER=reviewer

# ─────────────────────────────────────────────────────────────────────────────
# Cookie
# ─────────────────────────────────────────────────────────────────────────────
COOKIE_NAME=jwt
COOKIE_TTL=24h

# COOKIE_SECURE=true отправляет cookie только по HTTPS. Оставьте false при
# локальной разработке по http, иначе cookie не сохранится.
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# Очередь генерации
# ─────────────────────────────────────────────────────────────────────────────
# Сколько запросов к LLM выполняется одновременно.
QUEUE_CONCURRENCY=2

# Пауза между запросами одного воркера: ограничивает частоту обращений к API.
QUEUE_BETWEEN_REQUESTS=1s

# Как часто интерфейс опрашивает состояние задания, мс.
QUEUE_POLL_INTERVAL=500ms

# ─────────────────────────────────────────────────────────────────────────────
# Ограничение частоты запросов
# ─────────────────────────────────────────────────────────────────────────────
# Сколько попыток входа и регистрации разрешено с одного адреса за окно.
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=1m

# Максимальный размер тела запроса в байтах (1 МиБ).
MAX_REQUEST_BYTES=1048576

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter
# ─────────────────────────────────────────────────────────────────────────────
# Ключ из личного кабинета openrouter.ai: https://openrouter.ai/keys
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Заголовки атрибуции: без них использование не отображается в рейтингах
# OpenRouter. Укажите адрес, по которому открыто приложение.
OPENROUTER_REFERER=https://github.com/nikaydo/ReviewerBackend
OPENROUTER_TITLE=Reviewer

OPENROUTER_TIMEOUT=120s
OPENROUTER_RETRIES=2

# ─────────────────────────────────────────────────────────────────────────────
# Промты по умолчанию
# ─────────────────────────────────────────────────────────────────────────────
# Маркер <memory> в MEMORIZATION_PROMPT заменяется текущей памятью пользователя.
DEFAULT_MAIN_PROMPT=Ты — ИИ, который пишет развернутые, связные и живые отзывы на товары или книги. Учитывай множество аспектов продукта: характеристики и функциональность, пользовательский опыт и дизайн, производительность, поддержку клиентов, безопасность, совместимость и другие релевантные категории. В отзыве естественно и плавно включай комментарии по этим категориям, показывая как положительные, так и отрицательные стороны, если они есть. Для каждой затронутой категории определи настроение — положительное, отрицательное или нейтральное, но не выделяй это явно в тексте: пусть это будет видно из контекста и формулировок. В конце сделай общий вывод с рекомендацией, стоит ли покупать или читать, и кому этот товар или книга может подойти.

MEMORIZATION_PROMPT=Ты — ассистент, который помогает ИИ формировать факты о пользователе на основе текста. Эти факты хранятся в виде предложений. Вот текущая сохранённая память: <memory> Ниже — новый пользовательский текст. Проанализируй новый текст и извлеки важные факты: имена, места, предпочтения, бренды, события, даты. Не выбирай абстрактные факты вроде «гуляли у фонтана» или «ходил в магазин» — преобразуй их в отдельные короткие понятные предложения. Не повторяй то, что уже есть в сохранённой памяти. Верни предложения, которые содержат старую память и новые предложения, которые можно добавить. Не добавляй пояснений, комментариев или лишнего текста.